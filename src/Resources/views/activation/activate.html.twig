{% extends 'base.html.twig' %}

{% block title %}Activation du compte{% endblock %}

{% block body %}
    <h1>Activation du compte</h1>

    {% for flash in app.flashes('error') %}
        <div class="alert alert-danger">{{ flash }}</div>
    {% endfor %}

    {% for flash in app.flashes('success') %}
        <div class="alert alert-success">{{ flash }}</div>
    {% endfor %}

    {{ form_start(form) }}

        {{ form_errors(form) }}

        <div>
            {{ form_label(form.password) }}
            {{ form_widget(form.password) }}
            {{ form_errors(form.password) }} {# erreurs champ password #}
        </div>

        <div>
            {{ form_label(form.passwordConfirm) }}
            {{ form_widget(form.passwordConfirm) }}
            {{ form_errors(form.passwordConfirm) }} {# erreurs champ confirmation #}
        </div>

        <button class="btn btn-primary" type="submit">Activer le compte</button>

    {{ form_end(form) }}
{% endblock %}

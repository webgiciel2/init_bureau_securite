{% extends 'base.html.twig' %}

{% block title %}Activation du compte{% endblock %}

{% block body %}
    <h1>Activation du compte</h1>

    {% for message in app.flashes('error') %}
        <div class="alert alert-danger">{{ message }}</div>
    {% endfor %}

    {{ form_start(form) }}

        {{ form_errors(form) }}

        <div>
            {{ form_label(form.password) }}
            {{ form_widget(form.password, {'attr': {'class': 'form-control'}}) }}
            {{ form_errors(form.password) }}
        </div>

        <div>
            {{ form_label(form.password_confirm) }}
            {{ form_widget(form.password_confirm, {'attr': {'class': 'form-control'}}) }}
            {{ form_errors(form.password_confirm) }}
        </div>

        <button class="btn btn-primary" type="submit">Activer le compte</button>

    {{ form_end(form) }}
{% endblock %}
